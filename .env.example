# Server
PORT=8787
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
MASTER_ADMIN_LOGIN=finch-recovery
MASTER_ADMIN_PASSWORD=change-me-recovery-password
# Set true and provide MASTER_ADMIN_TOTP_SECRET (base32) to require TOTP for recovery login
MASTER_ADMIN_REQUIRE_2FA=false
# MASTER_ADMIN_TOTP_SECRET=

# Passkeys (WebAuthn). Defaults derive from the request Host/Origin.
# Set explicitly in production if the public hostname differs from the API host.
# WEBAUTHN_RP_ID=finch.example.com
# WEBAUTHN_ORIGIN=https://finch.example.com

# Postgres (required when NODE_ENV=production)
# For Docker Compose, host must be `db`:
# DATABASE_URL=postgres://finch:YOUR_PASSWORD@db:5432/finch
# For local Node against Compose Postgres, use 127.0.0.1 after publishing a port, or the container IP.
# Escape `$` in .env as `$$` so Docker Compose does not interpolate secrets.
# DATABASE_URL=postgres://finch:finch@127.0.0.1:5432/finch
POSTGRES_DB=finch
POSTGRES_USER=finch
POSTGRES_PASSWORD=change-me-db-password

# Behind Caddy/nginx in production
TRUST_PROXY=1
COOKIE_SECURE=true
LOGIN_RATE_LIMIT=30

# Public hostname for Caddy (Docker Compose)
FINCH_DOMAIN=finch.example.com
# Absolute public URL used in invite / password-reset emails (no trailing slash).
# Falls back to the request Host when unset.
# FINCH_PUBLIC_URL=https://finch.example.com

# SMTP (required for real notification + payroll emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Finch <noreply@example.com>"

# Backups (local rolling snapshots always; S3 is optional)
BACKUP_KEEP=14
BACKUP_INTERVAL_SECONDS=86400
# S3_BUCKET=
# S3_PREFIX=finch-backups/
# S3_REGION=auto
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Client (Vite proxy uses /api → server)
VITE_API_BASE=
